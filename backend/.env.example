# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Settings (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Storage Directory (relative to backend/ or absolute path)
STORAGE_DIR=storage

# Demucs Model Configuration
DEMUCS_MODEL=htdemucs
DEMUCS_TWO_STEMS=vocals
DEMUCS_DEVICE=auto
DEMUCS_MP3_BITRATE=320

# External AI Services (Gemini API for future lyrics sync & scoring)
GEMINI_API_KEY=your_gemini_api_key_here
